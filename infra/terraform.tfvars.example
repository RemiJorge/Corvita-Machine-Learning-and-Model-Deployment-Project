project_id = "<your-gcp-project-id>"
region     = "northamerica-northeast1"
env        = "demo"

# Build and push the image before applying the Cloud Run service (see infra/README.md).
# Image tag is your release label (e.g. 1.3.0). It does not have to match model_version.
image = "northamerica-northeast1-docker.pkg.dev/<your-gcp-project-id>/icu-api/icu-api:1.3.0"

# Must match a models/<version>/ directory copied in the Dockerfile (currently 1.0.0 only).
model_version          = "1.0.0"
allow_public_invoker   = false
data_team_members      = []
billing_account_id     = ""
budget_amount          = 5
force_destroy_bucket   = false
